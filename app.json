{
  "expo": {
    "name": "twofold",
    "slug": "twofold",
    "version": "0.3.1",
    "orientation": "portrait",
    "scheme": "twofold",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Opener-Policy": "same-origin",
            "Cross-Origin-Embedder-Policy": "require-corp"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eac31025-241d-4bcc-8bb3-84b96ec58c1b"
      }
    },
    "owner": "vitorgewe"
  }
}
